# Telegram Gifts Mini App — env example
# Copy to .env.local and fill in.
BOT_TOKEN=
# Public URL of deployed app, e.g. https://gift-xxx.vercel.app
MINI_APP_URL=
# Public bot username (without @) for referral links fallback
BOT_USERNAME=
# Comma-separated Telegram numeric IDs of admins
TELEGRAM_ADMIN_IDS=
# Postgres connection string (Supabase / Vercel Postgres). If empty, local JSON file DB is used.
DATABASE_URL=
# Webhook secret (optional, Telegram setWebhook secret_token)
WEBHOOK_SECRET=
# Allow dev auth via ?tg_id= when no Telegram initData (local testing only). Set false in prod.
ALLOW_DEV_AUTH=true
